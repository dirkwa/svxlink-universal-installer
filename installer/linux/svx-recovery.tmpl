#!/usr/bin/env bash
# svx-recovery — host-resident SvxLink safety net.
# Installed by svxlink-universal-installer. Does not depend on any
# container being running; talks only to ~/.config/containers/systemd/
# and `systemctl --user`. This is the recovery floor (ADR: no engine
# containers — what the signalk stack's doctor did over REST, this does
# in pure bash over SSH). Usage:
#
#   svx-recovery status              — unit states, Image= lines, newest snapshots
#   svx-recovery rollback-server     — restore the svxlink-server quadlet
#   svx-recovery rollback-dashboard  — restore the svxlink-dashboard quadlet
#   svx-recovery rollback-all        — restore both
#   svx-recovery doctor              — print a diagnostics dump

set -euo pipefail

QUADLET_DIR="${HOME}/.config/containers/systemd"
SNAP_DIR="${HOME}/.svxlink/snapshots"
LAST_GOOD="${HOME}/.svxlink/last-good.json"

# The dashboard is optional; every consumer below tolerates a missing
# quadlet/unit, so listing it unconditionally keeps status + rollback-all
# complete without a presence check.
QUADLETS=(svxlink-server svxlink-dashboard)

usage() {
    cat <<EOF
svx-recovery — SvxLink out-of-band recovery (no containers required).

Commands:
  status                   show unit states, images and newest snapshots
  rollback-server          restore svxlink-server.container from the newest snapshot
  rollback-dashboard       restore svxlink-dashboard.container from the newest snapshot
  rollback-all             restore both quadlets
  doctor                   dump systemd, podman, and recent-log diagnostics

Snapshots live under: $SNAP_DIR
Last-known-good index: $LAST_GOOD
EOF
}

newest_snapshot() {
    local quadlet=$1
    # find + sort handles non-alphanumeric filenames safely (shellcheck
    # SC2012 — never parse ls). %T@ %p prints mtime-since-epoch + path;
    # sort -nr picks the newest first.
    find "$SNAP_DIR" -maxdepth 1 -type f -name "*-${quadlet}.container" \
        -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | head -1 | cut -d' ' -f2-
}

show_status() {
    echo "Quadlet directory:  $QUADLET_DIR"
    echo "Snapshot directory: $SNAP_DIR"
    echo "Last-good index:    $LAST_GOOD"
    echo
    local q file active image newest
    for q in "${QUADLETS[@]}"; do
        file="$QUADLET_DIR/${q}.container"
        active=$(systemctl --user is-active "${q}.service" 2>/dev/null || true)
        active=${active%%$'\n'*}
        [[ -z "$active" ]] && active="unknown"
        image=""
        if [[ -f "$file" ]]; then
            image=$(awk -F= '/^Image=/{print $2; exit}' "$file")
        fi
        newest=$(newest_snapshot "$q" || true)
        printf '  %-24s active=%-12s image=%s\n' "$q" "$active" "${image:-<no quadlet>}"
        if [[ -n "$newest" ]]; then
            printf '  %-24s newest-snapshot=%s\n' "" "$newest"
        fi
    done
}

restore_one() {
    local quadlet=$1
    local src
    src=$(newest_snapshot "$quadlet" || true)
    if [[ -z "$src" ]]; then
        echo "no snapshot found for $quadlet" >&2
        return 1
    fi
    local target="$QUADLET_DIR/${quadlet}.container"
    # Sibling temp + mv: an interrupted copy must never leave a truncated
    # quadlet where the generator will parse it at the next daemon-reload.
    local tmp="${target}.recover.$$"
    cp -p "$src" "$tmp"
    mv -f "$tmp" "$target"
    echo "restored: $quadlet (from $src)"
}

reload_and_restart() {
    local services=("$@")
    systemctl --user daemon-reload
    local s
    for s in ${services[@]+"${services[@]}"}; do
        # try-restart: only bounce units that were running — never start a
        # unit the operator deliberately stopped.
        systemctl --user try-restart "${s}.service" || true
    done
}

cmd_rollback_server() {
    restore_one svxlink-server
    reload_and_restart svxlink-server
}

cmd_rollback_dashboard() {
    restore_one svxlink-dashboard
    reload_and_restart svxlink-dashboard
}

cmd_rollback_all() {
    local svcs=() q
    for q in "${QUADLETS[@]}"; do
        # Plain if-then so a successful restore_one followed by a failing
        # svcs+= doesn't trip the C branch (shellcheck SC2015); a missing
        # snapshot (e.g. dashboard never installed) skips that unit only.
        if restore_one "$q"; then
            svcs+=("$q")
        fi
    done
    reload_and_restart ${svcs[@]+"${svcs[@]}"}
}

cmd_doctor() {
    echo "--- podman ps ---"
    podman ps -a --format '{{.Names}}  {{.Status}}  {{.Image}}' 2>&1 || true
    echo
    echo "--- systemd-user svxlink-* units ---"
    systemctl --user list-units --all 'svxlink-*' 2>&1 || true
    echo
    # `podman logs`, not `journalctl --user -u`: rootless podman/conmon
    # writes container output to the journal under the CONTAINER
    # identifier, which the per-unit journal query does NOT surface — on a
    # typical Pi it returns "No journal files were found" and the actual
    # svxlink startup output (the thing needed here) stays invisible. The
    # container name maps 1:1 to the unit name.
    echo "--- podman logs (last 30 lines each) ---"
    local s
    for s in "${QUADLETS[@]}"; do
        echo "[${s}]"
        podman logs --tail 30 "$s" 2>&1 || true
        echo
    done
    echo "--- last-good.json ---"
    cat "$LAST_GOOD" 2>/dev/null || echo "(missing)"
}

case "${1:-status}" in
    status)             show_status ;;
    rollback-server)    cmd_rollback_server ;;
    rollback-dashboard) cmd_rollback_dashboard ;;
    rollback-all)       cmd_rollback_all ;;
    doctor)             cmd_doctor ;;
    -h|--help|help)     usage ;;
    *)                  usage; exit 1 ;;
esac
