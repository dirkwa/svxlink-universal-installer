[Unit]
Description=SvxLink dashboard (CN8VX, locally built - image is never pushed)
# The log dir and the confs this container scrapes come from the server's
# world; start after it so the first paint isn't empty. Wants (not
# Requires): a dashboard must keep answering while the server is being
# replaced by `svx update`.
Wants=svxlink-server.service
After=svxlink-server.service

# Same rationale as the server template: suppress podman 5.x's implicit
# user-session network-wait shim dependency (blocks up to 90s on hosts
# where the target never activates). Do not name the shim service here —
# the generator re-injects the dependency if it sees the string.
[Quadlet]
DefaultDependencies=false

[Container]
# ALWAYS a local build, never a registry pull: the CN8VX dashboard has NO
# license, so we may use it on this host but must not redistribute it —
# `svx dashboard install` clones the pinned fork commit and builds this
# tag locally on the target. Nothing may ever push this image.
Image=localhost/svxlink-dashboard:local
ContainerName=svxlink-dashboard

# WARNING: the dashboard has NO authentication. The default bind exposes
# it to the whole LAN (phones in the shack — the point of it); never
# port-forward or otherwise expose it to the WAN. Placeholders are
# substituted by the installer / `svx dashboard install` (default
# 0.0.0.0:8080; pick 127.0.0.1 for proxy-fronted setups).
PublishPort=__DASH_BIND__:__DASH_PORT__:80

# Everything the dashboard shows is derived from these read-only mounts —
# it has no write path at all.
#
# The server's log file + its single .1 rotation sibling (the entire
# primary data source — the dashboard tails and greps these).
Volume=%h/.svxlink/log:/var/log/svxlink:ro
# Main config only — deliberately NOT the whole ~/.svxlink/etc and NOT
# svxlink.d/: ModuleEchoLink.conf holds the EchoLink password in
# plaintext and the svxlink.d dir stays 0700 and out of this
# unauthenticated web container entirely.
Volume=%h/.svxlink/etc/svxlink.conf:/etc/svxlink/svxlink.conf:ro
# SANITIZED copy of ModuleEchoLink.conf (PASSWORD value replaced with
# REDACTED by seed-config.sh's sanitize-echolink helper, regenerated by
# `svx dashboard` and the `svx config` hook). The dashboard's EchoLink
# panel needs the callsign/sysop keys from this file, never the password.
Volume=%h/.svxlink/dashboard/ModuleEchoLink.conf:/etc/svxlink/svxlink.d/ModuleEchoLink.conf:ro
# Dashboard's own config surface, seeded-if-absent and operator-owned.
Volume=%h/.svxlink/dashboard/config.php:/var/www/html/include/config.php:ro
Volume=%h/.svxlink/dashboard/dash_config.php:/var/www/html/include/dash_config.php:ro
Volume=%h/.svxlink/dashboard/talkgroups.json:/var/www/html/include/talkgroups.json:ro
# CPU temperature panel reads the host thermal zones.
Volume=/sys/class/thermal:/sys/class/thermal:ro

# ADR: NO --pid=container:svxlink-server (no PID namespace sharing). It
# would make the dashboard's process-status probe honest, but it
# hard-couples the lifecycles: every server container replacement (every
# `svx update`) tears down the shared pid namespace and cascades the
# dashboard unit into failure. The degraded status LED is cosmetic —
# every functional panel is log-derived, and log recency already conveys
# liveness. Revisit only if users actually complain.

Label=io.svxlink.managed-by=svxlink-universal-installer
Label=io.svxlink.role=dashboard

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
